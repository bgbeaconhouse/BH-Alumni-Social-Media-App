{
  "cli": {
    "version": ">= 16.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
  "production": {
  "autoIncrement": true,
  "ios": {
    "image": "macos-sequoia-15.6-xcode-26.2",
    "buildConfiguration": "Release",
    "env": {
      "EXPO_USE_HERMES": "false"
    }
  },
  "android": {
    "buildType": "app-bundle"
  }
},
    "production-apk": {
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}